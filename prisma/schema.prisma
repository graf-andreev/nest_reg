generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  login     String   @unique
  email     String   @unique
  password  String
  age       Int
  about     String
  session   String?
  createdAt DateTime @default(now())
  deletedAt DateTime?
}
